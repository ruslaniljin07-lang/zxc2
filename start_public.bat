@echo off
chcp 65001 >nul
title Código - Публичный доступ
color 0A

echo.
echo ╔══════════════════════════════════════════════════════════════╗
echo ║           Código - Запуск с публичным доступом              ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.

echo [1/2] Запускаю Flask сервер...
start "Flask Server" cmd /c "python app.py"

echo Ожидаю запуска сервера...
timeout /t 5 /nobreak >nul

echo [2/2] Создаю публичный туннель...
echo.
echo ╔══════════════════════════════════════════════════════════════╗
echo ║                     ИНСТРУКЦИЯ                              ║
echo ╠══════════════════════════════════════════════════════════════╣
echo ║                                                              ║
echo ║  1. Подождите 10-15 секунд                                   ║
echo ║  2. В этом окне появится адрес сайта                         ║
echo ║  3. Скопируйте его и отправьте друзьям                       ║
echo ║                                                              ║
echo ║  Для остановки закройте это окно                             ║
echo ║                                                              ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.

ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 -R 80:localhost:5000 serveo.net

echo.
echo Сервер остановлен.
pause
